# Copier ce fichier en .env.local pour développer. Sur Vercel, ces valeurs se saisissent dans
# Project Settings → Environment Variables (jamais dans le dépôt).

# Supabase : Project Settings → API (ce sont des valeurs publiques, protégées par les droits par ligne)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mode démonstration : 1 = aucune connexion, données fictives gardées dans le navigateur
NEXT_PUBLIC_DEMO=
